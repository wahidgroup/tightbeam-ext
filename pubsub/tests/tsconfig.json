{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"noEmit": true,
		"types": ["@playwright/test", "node"],
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"resolveJsonModule": true,
		"paths": {
			"#pubsub-wire": ["../client/src/wire.generated.json"],
			"#ws-env": ["../../ws/tests/env.ts"],
			"#ws-fixtures": ["../../ws/tests/fixtures.ts"],
			"#ws-signer": ["../../ws/tests/signer.ts"]
		}
	},
	"include": [
		"app",
		"specs",
		"node",
		"aliases.ts",
		"vite.config.ts",
		"vitest.config.ts",
		"playwright.config.ts"
	]
}
