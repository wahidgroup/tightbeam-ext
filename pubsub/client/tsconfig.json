{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "ES2024.String", "ESNext.Disposable", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"declaration": true,
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"paths": {
			"typescript": ["../node_modules/typescript"]
		}
	},
	"include": ["src", "src/wire.generated.json"]
}
