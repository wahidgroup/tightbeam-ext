{
	"name": "@wahidgroup/tightbeam-pubsub-client",
	"version": "0.1.0",
	"description": "Topic subscriptions for the tightbeam WebSocket client: typed subscribe/unsubscribe lifecycle with per-topic ordering and reconnect replay.",
	"type": "module",
	"main": "dist/index.js",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE-MIT",
		"LICENSE-APACHE"
	],
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "eslint . && prettier --check .",
		"lint:fix": "eslint . --fix && prettier --write .",
		"smoke": "node --experimental-strip-types ../../ws/client/scripts/smoke-exports.ts",
		"pack:check": "node --experimental-strip-types ../../ws/client/scripts/check-pack.ts",
		"clean": "rm -rf dist coverage"
	},
	"dependencies": {
		"@wahidgroup/tightbeam-ws-client": "file:../../ws/client"
	},
	"devDependencies": {
		"@types/node": "24.0.4",
		"@wahidgroup/lint-rules": "0.1.2",
		"typescript": "5.9.3",
		"vitest": "4.1.10"
	},
	"publishConfig": {
		"registry": "https://npm.pkg.github.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/wahidgroup/tightbeam-ext"
	},
	"license": "MIT OR Apache-2.0"
}
