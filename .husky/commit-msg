#!/usr/bin/env sh
set -e

# The commit header rule of CONTRIBUTING.md (Title), from Conventional Commits 1.0.0.
# Usage: commit-msg <message-file> [title]

msg_file="$1"
mode="${2:-commit}"
if [ -z "$msg_file" ] || [ ! -f "$msg_file" ]; then
	echo "ERROR: commit-msg hook missing message file argument." >&2
	exit 1
fi

case "$mode" in
	commit | title) ;;
	*)
		echo "ERROR: unknown mode '$mode' (expected commit or title)." >&2
		exit 1
		;;
esac

# The subject is the first line that is neither a comment nor empty.
subject=""
while IFS= read -r line || [ -n "$line" ]; do
	case "$line" in
		\#*) continue ;;
	esac
	if [ -n "$line" ]; then
		subject="$line"
		break
	fi
done < "$msg_file"

if [ -z "$subject" ]; then
	echo "ERROR: empty commit message." >&2
	exit 1
fi

# Git writes these subjects for a commit. A pull request title is always the author's.
if [ "$mode" = commit ]; then
	case "$subject" in
		Merge\ * | Revert\ * | fixup!\ * | squash!\ *)
			exit 0
			;;
	esac
fi

# The allowed types, which both the pattern and the error text read.
types='build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test'
pattern='^('"$types"')(\([a-z0-9][a-z0-9/-]*\))?(!)?: [a-z0-9].+[^.]$'

if ! printf '%s\n' "$subject" | grep -Eq "$pattern"; then
	cat >&2 <<EOF
ERROR: commit header is not a valid Conventional Commit.

  Expected: <type>[optional scope][!]: <description>
  Types:    $types
  Type/scope MUST be lowercase
  Description MUST start with a lowercase letter or digit (not Sentence case)
  Description MUST NOT end with a period
  Spec:     https://www.conventionalcommits.org/en/v1.0.0/

  Got: $subject
EOF
	exit 1
fi

# The header-max-length of commitlint.
maxlen=100
len=$(printf '%s' "$subject" | wc -c | tr -d ' ')
if [ "$len" -gt "$maxlen" ]; then
	echo "ERROR: commit header is ${len} characters (max ${maxlen})." >&2
	echo "  Got: $subject" >&2
	exit 1
fi
