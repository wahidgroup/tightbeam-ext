#!/usr/bin/env sh
set -e

# Make reads no stdin, because stdin holds the ref list that the loop below reads.
if ! make lint </dev/null; then
	echo "ERROR: make lint failed; push aborted."
	exit 1
fi

remote="$1"
z40=0000000000000000000000000000000000000000

# Every pushed commit needs a valid signature, except the history the remote holds.
remote_head=$(git ls-remote "$remote" HEAD 2>/dev/null | awk 'NR == 1 { print $1 }')
if [ -z "$remote_head" ]; then
	echo "ERROR: Could not query $remote for its default branch tip (network or auth error)."
	echo "       Cannot determine which commits are new without it."
	exit 1
fi
if ! git cat-file -e "${remote_head}^{commit}" 2>/dev/null; then
	echo "ERROR: $remote default branch tip $remote_head is not present locally."
	echo "       Run: git fetch $remote"
	exit 1
fi

while read -r _ local_oid _ remote_oid; do
	if [ "$local_oid" = "$z40" ]; then
		continue
	fi

	exclude="$remote_head"
	if [ "$remote_oid" != "$z40" ]; then
		exclude="$exclude $remote_oid"
	fi

	# shellcheck disable=SC2086 # Each word of $exclude is one oid for --not.
	for commit in $(git rev-list "$local_oid" --not $exclude); do
		if ! git verify-commit "$commit" 2>/dev/null; then
			echo "ERROR: Commit $commit has an invalid or missing signature."
			echo "       All commits must have a valid signature before pushing."
			exit 1
		fi
	done
done
