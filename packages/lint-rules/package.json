{
	"name": "@wahidgroup/lint-rules",
	"version": "0.1.0",
	"description": "Shared ESLint, Prettier, TypeScript, and cspell configuration for TypeScript packages.",
	"type": "module",
	"engines": {
		"node": "24.14.0",
		"npm": "11.9.0"
	},
	"exports": {
		"./eslint/base": "./eslint/base.mjs",
		"./eslint/react": "./eslint/react.mjs",
		"./eslint/nestjs": "./eslint/nestjs.mjs",
		"./eslint/playwright": "./eslint/playwright.mjs",
		"./prettier": "./prettier.mjs",
		"./tsconfig": "./tsconfig.base.json",
		"./cspell": "./cspell.base.yaml"
	},
	"files": [
		"eslint",
		"prettier.mjs",
		"tsconfig.base.json",
		"cspell.base.yaml"
	],
	"dependencies": {
		"@darraghor/eslint-plugin-nestjs-typed": "7.1.24",
		"@eslint/js": "9.39.2",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-import": "2.32.0",
		"eslint-plugin-jsx-a11y": "6.10.2",
		"eslint-plugin-playwright": "2.9.0",
		"eslint-plugin-react-hooks": "7.0.1",
		"typescript-eslint": "8.54.0"
	},
	"peerDependencies": {
		"eslint": ">=9",
		"prettier": ">=3",
		"typescript": ">=5"
	},
	"peerDependenciesMeta": {
		"prettier": {
			"optional": true
		}
	},
	"publishConfig": {
		"registry": "https://npm.pkg.github.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/wahidgroup/tightbeam-ws"
	},
	"license": "MIT OR Apache-2.0"
}
