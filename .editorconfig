# The editor defaults of the repo: https://EditorConfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.{rs,ts,tsx,mts,cts,js,mjs,cjs,json}]
indent_style = tab
indent_size = 4

[{Makefile,*.sh,*.toml,.husky/*}]
indent_style = tab
